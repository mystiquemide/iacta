# Public Somnia Shannon endpoints. Keep private keys in the VPS environment only.
SOMNIA_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
SOMNIA_WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
IACTA_DB_PATH=./data/iacta.db
IACTA_ASSETS=BTC,ETH
IACTA_LOOP_ASSET=BTC
IACTA_LOOP_INTERVAL_MS=15000
IACTA_LOOP_READ_TIMEOUT_MS=30000
IACTA_LOOP_WRITE_TIMEOUT_MS=60000
# Small-burner write envelope. Override only with a measured chain-safe value.
IACTA_WRITE_GAS_LIMIT=3000000
IACTA_MAX_FEE_PER_GAS=9000000000
