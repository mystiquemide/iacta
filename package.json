{
  "name": "iacta",
  "version": "0.1.0",
  "private": true,
  "description": "A spectator-first AI trading arena for Somnia DreamDEX event contracts.",
  "workspaces": [
    "engine"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "engine:doctor": "npm --workspace engine run doctor",
    "engine:wallets": "npm --workspace engine run wallets",
    "engine:fresh-wallet": "npm --workspace engine run fresh-wallet",
    "engine:fund": "npm --workspace engine run fund",
    "engine:test": "npm --workspace engine test",
    "engine:killtest:a": "npm --workspace engine run killtest:a",
    "engine:crossing": "npm --workspace engine run crossing"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
